        end
        object lblArchDirMonitorDesc: TLabel
          Left = 40
          Height = 30
          Top = 116
          Width = 820
          Caption = 'Varre periodicamente uma pasta de entrada (inbox), testa com segurança se arquivos estão liberados (não bloqueados por cópia)'#10'e os movimenta automaticamente para pastas de processados ou erro.'
          Font.Color = 4210752
          Font.Height = -12
          Font.Style = []
          ParentColor = False
          ParentFont = False
        end
